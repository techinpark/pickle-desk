{
  "name": "pickle-desk",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc -b && oxlint && vitest run && vite build && node tool/check_build.mjs",
    "e2e": "VITE_GOOGLE_CLIENT_ID=e2e.apps.googleusercontent.com vite build && e2e run"
  },
  "dependencies": {
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.15.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "e2e": "^0.21.3",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "description": "Hand tasks to Pickle (your AI assistant) through a Google Sheet — an installable PWA, no server needed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/techinpark/pickle-desk.git"
  },
  "private": true
}
